# Copy this file to .env and replace placeholder credentials before use.

# PostgreSQL
POSTGRES_DB=lumen
POSTGRES_USER=lumen
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_IMAGE=postgres:16-alpine

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=policy_documents
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_IMAGE=qdrant/qdrant:v1.15.3

# Application
APP_PORT=5000
STREAMLIT_PORT=8501
DATA_DIR=data
PDF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM provider: gemini, openai, or openai-compatible
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=
LLM_READ_TIMEOUT_SECONDS=180
LLM_API_KEY=
GEMINI_KEY=
OPENAI_API_KEY=
